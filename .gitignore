# data and logs produced by the runs
# Anchored at the root: without the leading slash, `logs/` swallows any folder of
# that name at any depth — it kept the `web/app/inspect-view/[runId]/logs/`
# route, which serves the logs to the viewer, out of the repository and therefore
# out of the deployment. The button then showed on no run at all.
/logs/
/local/*
/backend/logs/

# os
.DS_Store
*.tsbuildinfo

# The agents' workspaces. Both live INSIDE the repository: a worktree created
# under `.claude/worktrees/` is a whole copy of the tree, and without this line
# `git status` offers it for adding from the root. The progress log is session
# scratch, not history.
/.claude/worktrees/
/.superpowers/
