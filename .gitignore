# données et logs produits par les runs
# Ancré à la racine : sans la barre de tête, `logs/` avale tout dossier de
# ce nom à n'importe quelle profondeur — il a tenu hors du dépôt, donc hors
# du déploiement, la route `web/app/inspect-view/[runId]/logs/` qui sert les
# journaux au viewer. Le bouton ne s'affichait alors sur aucun run.
/logs/
/local/*
/backend/logs/

# os
.DS_Store
*.tsbuildinfo

# Espaces de travail des agents. Les deux vivent DANS le dépôt : un worktree
# créé sous `.claude/worktrees/` est une copie complète de l'arbre, et sans
# cette ligne `git status` la propose à l'ajout depuis la racine. Le journal
# d'avancement est du brouillon de session, pas de l'histoire.
/.claude/worktrees/
/.superpowers/
