# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# xAI / Grok — https://console.x.ai
# Note: GROK_API_KEY is also accepted as an alias for XAI_API_KEY
XAI_API_KEY=

# Google / Gemini — https://aistudio.google.com/apikey
# Note: GOOGLE_API_KEY is accepted too; inspect_ai reads both.
GEMINI_API_KEY=

SUPABASE_URL=https://hkqzamibfpyvlowiqgpn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BATCH_TRIGGER_URL=
BATCH_TRIGGER_SECRET=
LOCAL_AUTHENTICATION_NEEDED=false
LOCAL_AUTHENTICATION_EMAIL=
AUTH_GOOGLE_ID=602095736601-cvrpe75t6th6nlnlgco78kkgqqa87e3n.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# The MCP connector's fixed client_id, typed in by hand in claude.ai
# ("Use your own OAuth client"). Any string will do — neither a Google secret,
# nor a third party's OAuth identifier.
MCP_CLIENT_ID=

# The two caps of launch_draft, the only MCP tool that spends real money, live
# in the `profiles` table — one row per person, no environment variable here:
# see web/lib/profiles.ts.

# Local development: the interpreter that runs the evaluation job, when
# BATCH_TRIGGER_URL is not set. Without it no run can start locally — that is
# deliberate, the path must not be guessed.
EVAL_PYTHON=.venv/bin/python
